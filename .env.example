# ============================================================
# V2Board Docker 环境配置
# 复制为 .env 后修改，然后 docker compose up -d
# APP_KEY 留空，首次启动自动生成
# ============================================================

# ── Docker Compose ───────────────────────────────────────────
V2BOARD_PORT=7680
DOCKER_NETWORK=1panel-network
TZ=Asia/Shanghai

# ── 应用 ─────────────────────────────────────────────────────
APP_NAME=V2Board
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
LOG_CHANNEL=daily

# ── 数据库（必填） ──────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=v2board
DB_USERNAME=v2board
DB_PASSWORD=

# ── Redis（必填） ───────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# ── 缓存 / 队列 / 会话 ─────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

